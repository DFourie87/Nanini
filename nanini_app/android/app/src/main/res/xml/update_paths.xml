<?xml version="1.0" encoding="utf-8"?>
<!-- Where in-app updates are downloaded (see MainActivity.kt): Android's
     DownloadManager saves into the app's own Download folder; the older
     in-app download used cache/updates. -->
<paths>
    <external-files-path name="downloads" path="Download/" />
    <cache-path name="updates" path="updates/" />
</paths>
